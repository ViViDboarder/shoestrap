#! /usr/bin/env python3
import argparse
import json
import os
from ssl import CERT_NONE, PROTOCOL_TLS_CLIENT, SSLContext
from typing import Any, NamedTuple, cast
import urllib.request
from http.client import HTTPResponse

OLLAMA_HOST = os.getenv("OLLAMA_HOST", "https://ollama.thefij.rocks")
LLAMACPP_HOST = os.getenv("LLAMACPP_HOST", "https://nollama.mira.thefij")


class Ollama:
    @classmethod
    def get_running_models(cls) -> list[str]:
        # Get list of all loaded ollama models
        response: HTTPResponse
        with urllib.request.urlopen(f"{OLLAMA_HOST}/api/ps") as response:
            data = response.read()
            result = json.loads(data.decode())

        return [model["model"] for model in result["models"]]


    @classmethod
    def unload_model(cls, model: str) -> bool:
        # Unload an ollama model

        req = urllib.request.Request(
            f"{OLLAMA_HOST}/api/generate",
            data=json.dumps({"model": model, "keep_alive": 0}).encode("utf-8"),
            headers={"Content-Type": "application/json"},
            method="POST"
        )

        response: HTTPResponse
        with urllib.request.urlopen(req) as response:
            result_data = json.loads(response.read().decode("utf-8"))
            if result_data["done_reason"] != "unload":
                return False

        return True

    @classmethod
    def unload_all(cls) -> list[str]:
        failed_models: list[str] = []
        for model in cls.get_running_models():
            if not cls.unload_model(model):
                failed_models.append(f"ollama/{model}")

        return failed_models


class LlamaCPP:
    @classmethod
    def _request(cls, path: str, data: dict[str, Any]|None = None, method="GET") -> dict[str, Any]:
        response: HTTPResponse

        context = SSLContext(PROTOCOL_TLS_CLIENT)
        context.check_hostname = False
        context.verify_mode = CERT_NONE

        req = urllib.request.Request(
            f"{LLAMACPP_HOST}{path}",
            data=json.dumps(data).encode("utf-8") if data else None,
            method=method,
        )

        with urllib.request.urlopen(req, context=context) as response:
            data = response.read().decode()

            if response.status < 200 or response.status >= 300:
                raise ValueError("Llama CPP request failed", data)

            return json.loads(data)

    @classmethod
    def get_running_models(cls) -> list[str]:
        running_models: list[str] = []

        result = cls._request("/v1/models")

        for model in result["data"]:
            if model_status := model.get("status"):
                if model_status["value"] == "loaded":
                    running_models.append(model["id"])

        return running_models


    @classmethod
    def unload_model(cls, model: str) -> bool:
        result = cls._request("/models/unload", {"model": model}, method="POST")

        if result.get("success"):
            return True
        else:
            return False

    @classmethod
    def unload_all(cls) -> list[str]:
        failed_models: list[str] = []
        for model in cls.get_running_models():
            if not cls.unload_model(model):
                failed_models.append(f"ollama/{model}")

        return failed_models

class NollamaArgs(NamedTuple):
    no_ollama: bool
    no_llamacpp: bool


def parse_args() -> NollamaArgs:
    parser = argparse.ArgumentParser("nollama", description="Unloads models from Ollama and LlamaCPP")
    _ = parser.add_argument("--no-ollama", action="store_true", help="Do not unload Ollama models")
    _ = parser.add_argument("--no-llamacpp", action="store_true", help="Do not unload LlamaCPP models")
    args = parser.parse_args()

    return NollamaArgs(
        no_ollama=cast(bool, args.no_ollama),
        no_llamacpp=cast(bool, args.no_llamacpp),
    )


def main() -> int:
    args = parse_args()
    failed_models: list[str] = []

    if not args.no_ollama:
        failed_models += Ollama.unload_all()
    if not args.no_llamacpp:
        failed_models += LlamaCPP.unload_all()

    if failed_models:
        print("Error unloading models:")
        for model in failed_models:
            print(model)

        return 1

    return 0


if __name__ == "__main__":
    exit(main())
