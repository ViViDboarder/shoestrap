#! /usr/bin/env python3
import json
import os
import urllib.request
from http.client import HTTPResponse

OLLAMA_HOST = os.getenv("OLLAMA_HOST", "http://127.0.0.1:11434")


def get_running_models() -> list[str]:
    # Get list of all loaded ollama models
    response: HTTPResponse
    with urllib.request.urlopen(f"{OLLAMA_HOST}/api/ps") as response:
        data = response.read()
        result = json.loads(data.decode())

    return [model["model"] for model in result["models"]]


def unload_model(model: str) -> bool:
    # Unload an ollama model

    req = urllib.request.Request(
        f"{OLLAMA_HOST}/api/generate",
        data=json.dumps({"model": model, "keep_alive": 0}).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST"
    )

    response: HTTPResponse
    with urllib.request.urlopen(req) as response:
        result_data = json.loads(response.read().decode("utf-8"))
        if result_data["done_reason"] != "unload":
            return False

    return True


def main() -> int:
    result = 0

    for model in get_running_models():
        if not unload_model(model):
            print(f"Failed to unload {model}")
            result = 1

    return result


if __name__ == "__main__":
    exit(main())
