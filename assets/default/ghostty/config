# Starting window size
window-height = 30
window-width = 100
# Font configuration
font-family = Menlo

# Disable ligatures
font-feature = -calt

# Configure theme
theme = Wombat-iTerm
# theme = light:Builtin Solarized Light,dark:Builtin Solarized Dark

# Quick terminal - only works on macOS for now
keybind = global:cmd+shift+grave_accent=toggle_quick_terminal
